{
  "manifest_version": 3,
  "name": "Browser Recorder",
  "version": "1.0.0",
  "description": "Record a browser tab, a window or your whole screen — with the sound.",
  "minimum_chrome_version": "116",
  "permissions": ["tabCapture", "offscreen", "downloads", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Browser Recorder",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
